{
  "enabled": true,
  "timezone": "Asia/Tokyo",
  "schedule": {
    "frequency": "weekly_3x",
    "days": ["monday", "wednesday", "friday"],
    "time": "03:03",
    "cron": "3 3 * * 1,3,5"
  },
  "model": {
    "provider": "github_models",
    "name": "openai/gpt-4.1",
    "temperature": 0.9
  },
  "output": {
    "directory": "poems/generated",
    "create_pull_request": true,
    "auto_merge": true,
    "merge_method": "squash",
    "reader_mode": true
  },
  "language_selection": {
    "mode": "rotate",
    "order": ["arem", "en", "vela"],
    "maximum_consecutive_same_source": 1
  },
  "generation_unit": {
    "source_poems": 1,
    "translations_per_source": 2
  }
}
