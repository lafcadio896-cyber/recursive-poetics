{
  "enabled": true,
  "timezone": "Asia/Tokyo",
  "schedule": {
    "provider": "chatgpt_schedule",
    "frequency": "daily",
    "time": "03:03"
  },
  "generator": {
    "provider": "chatgpt",
    "reads_repository_context": true,
    "updates_lexicon": true,
    "rejects_lexical_conflicts": true,
    "uses_productive_morphology": true,
    "tracks_language_history": true,
    "language_history_spec": "LANGUAGE_HISTORY.md",
    "language_history_state": "state/language-history.json",
    "tracks_cultural_pragmatics": true,
    "cultural_contact_spec": "CULTURAL_CONTACT.md",
    "cultural_contact_state": "state/cultural-contact.json",
    "cultural_contact_enabled": false
  },
  "output": {
    "directory": "poems/generated",
    "integration_mode": "direct_commit",
    "target_branch": "main",
    "reader_mode": true
  },
  "language_selection": {
    "mode": "rotate",
    "order": ["arem", "en", "vela"],
    "maximum_consecutive_same_source": 1
  },
  "generation_unit": {
    "source_poems": 1,
    "translations_per_source": 2,
    "lexicon_update_required": true,
    "new_lexemes": {
      "source_language_minimum": 1,
      "source_language_maximum": 3,
      "translation_language_minimum": 0,
      "translation_language_maximum": 3,
      "prefer_derived_forms": true,
      "allow_zero_only_when_conflict_risk": true,
      "prefer_conceptual_lexemes_over_object_labels": true,
      "require_semantic_necessity": true
    },
    "new_grammar": {
      "minimum": 0,
      "maximum": 1,
      "prefer_historical_development": true,
      "allow_direct_invention_only_when_no_existing_source_expression": true
    },
    "poetic_quality": {
      "enabled": true,
      "create_japanese_emotional_core_before_conlang_realization": true,
      "require_memorable_image_or_line": true,
      "reject_safe_recombination_only": true,
      "avoid_recent_image_clusters": ["rain-moon-bird-dawn-memory-absence"],
      "expand_universal_domains": ["body", "kinship", "love", "grief", "aging", "birth", "death", "labor", "hunger", "sleep", "journey", "separation", "return", "land", "season", "ritual"],
      "modern_urban_scenes_deferred": true,
      "prefer_language_specific_emotional_transformation": true,
      "self_review_before_publish": {
        "japanese_translation_stands_as_poem": true,
        "contains_new_semantic_discovery": true,
        "new_lexeme_is_worth_learning": true,
        "not_dominated_by_recent_motifs": true
      }
    },
    "language_change": {
      "review_candidates_every_generation": true,
      "prefer_reuse_over_new_candidate": true,
      "minimum_distinct_poems_for_grammar": 3,
      "preserve_etymology": true,
      "preserve_old_forms": true,
      "update_state_with_poem": true
    },
    "cultural_pragmatics": {
      "collect_during_normal_generation": true,
      "generate_contact_events": false,
      "record_register_when_relevant": true,
      "record_cultural_domain_when_relevant": true,
      "record_translation_gap_when_relevant": true,
      "record_misreading_risk_when_relevant": true,
      "do_not_expose_divine_translation_to_speakers": true
    },
    "word_length": {
      "mix_short_medium_long": true,
      "short_characters": [2, 3],
      "medium_characters": [4, 6],
      "long_characters": [7, 10],
      "reject_uniform_length_lines": true
    }
  }
}
